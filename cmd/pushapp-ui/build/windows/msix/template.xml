<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="pushapp-ui"
        Arguments=""
        InstallLocation="C:\Program Files\My Company\Push Tethered App">
    </Installer>
    <PackageInformation
        PackageName="Push Tethered App"
        PackageDisplayName="Push Tethered App"
        PublisherName="CN=My Company"
        PublisherDisplayName="My Company"
        Version="0.1.0.0"
        PackageDescription="Module host for Ableton Push 2/3 in tethered mode">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.federicopepe.push-tethered-app"
                Description="Module host for Ableton Push 2/3 in tethered mode"
                DisplayName="Push Tethered App"
                ExecutableName="pushapp-ui"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Push Tethered App</DisplayName>
            <PublisherDisplayName>My Company</PublisherDisplayName>
            <Description>Module host for Ableton Push 2/3 in tethered mode</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="pushapp-ui.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
